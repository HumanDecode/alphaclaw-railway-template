{
  "name": "openclaw-railway",
  "version": "2.0.0",
  "private": true,
  "description": "OpenClaw on Railway \u2014 one-click deploy, powered by @chrysb/alphaclaw",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:stop": "docker compose down",
    "dev:clean": "docker compose down -v",
    "dev:logs": "docker compose logs -f",
    "dev:shell": "docker compose exec openclaw bash"
  },
  "dependencies": {
    "@chrysb/alphaclaw": "git+https://github.com/HumanDecode/alphaclaw-decode.git#1b7ab79fe7b403f0b91470d5dcdb8228762a18e1"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
